NoaWeapon: {
	DisplayName: 书记的表决
	Tooltip:
		'''
		右键可进行点射
		点射命中降低敌人{0}的防御力
		'''
	FlavorTooltip:
		'''
		诺亚使用的带有改装附件的手枪
		拉开枪托就可以像冲锋枪一样连射
		'''
}

MikaWeapon: {
	DisplayName: Quis ut Deus
	Tooltip: ""
	FlavorTooltip:
		'''
		未花爱用的冲锋枪
		未花将平平无奇的圣三一制
		冲锋枪用心装饰后的产物
		如今即使在黑暗中也会发出
		星光般的闪耀，随时都能为
		未花献上活跃
		'''
}

