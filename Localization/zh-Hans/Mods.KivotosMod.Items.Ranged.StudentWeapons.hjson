HoshinoWeapon: {
	DisplayName: 荷鲁斯之眼
	Tooltip:
		'''
		手持时增加{0}防御力
		低概率击晕敌人并治愈自身
		'''
	FlavorTooltip:
		'''
		星野爱用的简洁造型的霰弹枪
		平时懒洋洋的她，唯独对于枪
		的整备绝不会懈怠
		'''
}

HinaWeapon: {
	DisplayName: 终幕·毁灭者
	Tooltip: 攻击时间越长，发射的子弹越多
	FlavorTooltip:
		'''
		日奈的机关枪，她视其为手足
		违反校规扰乱风纪之人，都将
		会被冷酷无情的破坏力所吹飞
		'''
}

HarukaWeapon: {
	DisplayName: 驱散者
	Tooltip: ""
	FlavorTooltip:
		'''
		遥香用来驱虫的霰弹枪
		也可以用来处理“跟虫子一样的
		东西”
		'''
}

KayokoWeapon: {
	DisplayName: 恶魔咆哮
	Tooltip: ""
	FlavorTooltip:
		'''
		佳代子经常携带的手枪
		和它的名字一样，在射击时会
		发出惊人的轰响，因此在室内
		必须装备消音器
		'''
}

MidoriWeapon: {
	DisplayName: 新鲜灵感
	Tooltip: ""
	FlavorTooltip:
		'''
		绿使用的步枪 
		枪上挂着心爱的姐姐送给她的
		装饰吊坠，遇到难关时，摸一
		摸这个吊坠好像就能突发灵感
		'''
}

KoharuWeapon: {
	DisplayName: 黑色正义
	Tooltip: ""
	FlavorTooltip:
		'''
		小春使用的狙击步枪
		枪名是小春还在正义实现部
		时起的
		'''
}

YuukaWeapon: {
	DisplayName: 逻辑与理性
	Tooltip: ""
	FlavorTooltip:
		'''
		优香使用的两挺冲锋枪
		它能在重要的时刻帮助优香
		做出符合逻辑和理性的判断
		'''
}

MeguWeapon: {
	DisplayName: 天惠神力！
	Tooltip: ""
	FlavorTooltip:
		'''
		在开发现场与惠融为一体的
		火焰喷射器
		由于其本身释放出的庞大热
		量，其他人都驾驭不了这把
		武器，至于武器的名字，来
		自有人曾说过的一句玩笑，
		惠很喜欢，于是就用它为武
		器命名
		'''
}

MomoiWeapon: {
	DisplayName: 独特创意
	Tooltip: ""
	FlavorTooltip:
		'''
		桃使用的步枪
		枪上挂着心爱的妹妹送给她
		的装饰吊坠，当遇到难关时，
		摸一摸这个吊坠好像就能想
		出好主意
		'''
}

MutsukiWeapon: {
	DisplayName: 给不给糖都捣蛋
	Tooltip: ""
	FlavorTooltip:
		'''
		睦月随身携带的机关枪
		据睦月所说，为了更有趣的恶
		作剧，火力也很重要呢
		'''
}

SerikaWeapon: {
	DisplayName: 诚意
	Tooltip: ""
	FlavorTooltip:
		'''
		芹香出去兼职时经常携带的
		突击步枪
		诚实勤奋的芹香总是把它保
		养得干净漂亮
		'''
}

AruWeapon: {
	DisplayName: 酒红色赞赏
	Tooltip: ""
	FlavorTooltip:
		'''
		阿露平时十分重视，古风设计
		的狙击步枪
		仅仅是拿着它，好像...冷硬
		的程度就提升了
		'''
}

IrohaWeapon: {
	DisplayName: 万魔殿制式手枪
	Tooltip: ""
	FlavorTooltip:
		'''
		伊吕波随身携带的手枪
		伊吕波说因为自己是战车长
		所以没什么使用机会，但她
		的射击姿势优美到足以成为
		教科书上的示例
		'''
}

KasumiWeapon: {
	DisplayName: 红色莱克特
	Tooltip: ""
	FlavorTooltip:
		'''
		霞随身携带的手枪
		虽然大部分的情况都是为了
		活跃气氛而向空中开枪，但
		与小巧可爱的外观相反，它
		的威力十分强劲
		'''
}

NoaWeapon: {
	DisplayName: 秘书的裁断
	Tooltip:
		'''
		右键可进行点射
		点射命中降低敌人{0}的防御力
		'''
	FlavorTooltip:
		'''
		诺亚使用的带有改装附件的手枪
		拉开枪托就可以像冲锋枪一样连射
		'''
}

MikaWeapon: {
	DisplayName: Quis ut Deus
	Tooltip: ""
	FlavorTooltip:
		'''
		未花爱用的冲锋枪
		未花将平平无奇的圣三一制
		冲锋枪用心装饰后的产物
		如今即使在黑暗中也会发出
		星光般的闪耀，随时都能为
		未花献上活跃
		'''
}

ShirokoWeapon: {
	DisplayName: 白牙465
	Tooltip: ""
	FlavorTooltip:
		'''
		白子喜欢用的突击步枪
		因为白子平时会精心保养
		所以无论发生任何状况
		都能够立刻投入使用
		'''
}

IbukiWeapon: {
	DisplayName: 邦邦——！酱
	Tooltip: ""
	FlavorTooltip:
		'''
		伊吹十分珍视的枪
		伊吹在从「万魔殿」的前辈那里继承来
		的制式步枪上贴上了喜欢的贴纸、挂上
		了喜欢的挂件，据说是伊吹不可替代的
		重要的宝物
		'''
}

HikariWeapon: {
	DisplayName: 检票钳
	Tooltip: ""
	FlavorTooltip:
		'''
		光最爱用的手枪。
		对暴躁的「麻烦——」乘客效果拔群
		不管怎么说，似乎很用心地保养着
		'''
}

NozomiWeapon: {
	DisplayName: 致命·扳机
	Tooltip: ""
	FlavorTooltip:
		'''
		望爱用的手枪
		虽然平时不怎么用，但为了随时排除扰
		乱列车时刻表的因素，始终维护得很好
		'''
}

YuzuWeapon: {
	DisplayName: 喵喵冲击
	Tooltip: ""
	FlavorTooltip:
		'''
		柚子一直随身携带的榴弹发射器
		枪身侧面会显示可爱的猫咪奔跑的画面
		'''
}

NagisaWeapon: {
	DisplayName: 皇家红茶
	Tooltip: ""
	FlavorTooltip:
		'''
		渚爱用的小型手枪
		设计古典，能自然地与持有者融为一体
		即使在高雅的茶会中也不显得突兀，在
		驱逐一些有辱茶会品味的不速之客时会
		派上用场
		'''
}

SeiaWeapon: {
	DisplayName: 锐利光芒
	Tooltip: ""
	FlavorTooltip:
		'''
		圣娅惯用的手枪
		设计尽显茶话会成员应有的典雅与沉稳，
		如同从不吝啬犀利言辞的圣娅本人，时
		刻处于子弹上膛的待发状态
		'''
}
