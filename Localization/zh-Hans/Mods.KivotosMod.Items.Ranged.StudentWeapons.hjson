IbukiWeapon: {
	DisplayName: 邦邦—！酱
	Tooltip: ""
	FlavorTooltip:
		'''
		伊吹十分珍视的枪。
		伊吹在从「万魔殿」的前辈那里继承来的制式步枪上
		贴上了喜欢的贴纸、挂上了喜欢的挂件。
		据说是伊吹不可替代的重要的宝物。
		'''
}

HikariWeapon: {
	DisplayName: 车票・拳
	Tooltip: ""
	FlavorTooltip:
