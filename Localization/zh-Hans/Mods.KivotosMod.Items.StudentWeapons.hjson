HoshinoWeapon: {
	DisplayName: 荷鲁斯之眼
	Tooltip:
		'''
		手持时增加{0}防御力
		低概率击晕敌人并治愈自身
		'''
	FlavorTooltip:
		'''
		星野爱用的简洁造型的霰弹枪
		平时懒洋洋的她，唯独对于枪
		的整备绝不会懈怠
		'''
}

HinaWeapon: {
	DisplayName: 终幕·毁灭者
	Tooltip: 攻击时间越长，发射的子弹越多
	FlavorTooltip:
		'''
		日奈的机关枪，她视其为手足
		违反校规扰乱风纪之人，都将
		会被冷酷无情的破坏力所吹飞
		'''
}

